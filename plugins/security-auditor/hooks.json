{
  "harness2-guardrail-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ../../scripts/hooks/pre-tool-guardrail.cjs",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ../../scripts/hooks/stop-validator-gate.cjs",
        "timeout": 15
      }
    ]
  }
}
