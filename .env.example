# Per-Server Environment Configuration (chmod 600 .env)
# Never commit live LLM API keys or Discord webhook URLs to version control.

SERVER_ID="prod-app-eu-01"
AUDIT_PROFILE="standard"
AUDIT_TARGET_ROOT="/opt/services"

# LLM Token & Provider Configuration (Portable across servers)
LLM_PROVIDER="gemini"
AUDIT_LLM_API_KEY="your-llm-api-key-here"
LLM_BASE_URL=""

# Subagent Model Tier Routing (Optimize token spend)
MODEL_ORCHESTRATOR="pro"
MODEL_RECON="flash"
MODEL_HUNTER="pro"
MODEL_CRITIC="flash"
MODEL_VERIFIER="pro"
MODEL_RECORD_VERIFIER="flash"
MODEL_REPORTER="flash"

# Discord Webhook Configuration (Can be changed per server)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"
DISCORD_MENTION_ROLE=""
